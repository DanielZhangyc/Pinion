strict_env

watch_file go.mod go.sum

export GOTOOLCHAIN=go1.27.2
export CGO_ENABLED=0
export GOPATH="$PWD/.direnv/go"
export GOBIN="$PWD/.direnv/bin"
export GOCACHE="$PWD/.direnv/cache/go-build"
export GOMODCACHE="$PWD/.direnv/cache/go-mod"

mkdir -p "$GOBIN" "$GOCACHE" "$GOMODCACHE"
PATH_add "$GOBIN"
